# All three lane apps (p1_app.py, p2_app.py, p3_app.py) and skeleton.py read
# this SAME variable, so they share one database -- that's how P3 finds the
# rubric/grade P1/P2 persisted. Docker Compose sets this to its PostgreSQL
# service; for local Streamlit runs it defaults to one shared sqlite file if
# left unset, so a plain local run without any env var still shares data
# across all three apps automatically.
DATABASE_URL=sqlite:///grading_demo.db

# BYOK model settings reserved for the shared provider integration.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=

# P2 critic independence (optional): point the critic at a different model
# and/or temperature than the grader so it isn't just replaying the same
# deterministic reasoning under an adversarial prompt. Both default sensibly
# if left blank (same model as MODEL_NAME, temperature 0.7).
CRITIC_MODEL_NAME=
CRITIC_TEMPERATURE=
